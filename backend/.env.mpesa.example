# M-Pesa Daraja configuration (backend)
# Obtain sandbox credentials from https://developer.safaricom.co.ke/
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a public HTTPS endpoint reachable by Safaricom, e.g.
# https://your-api-domain.example/api/orders/mpesa/callback/
MPESA_CALLBACK_URL=
# Generate a long random value; the server appends it as ?token=... to callbacks.
MPESA_CALLBACK_TOKEN=
