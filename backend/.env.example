# Copy to backend/.env and fill in. Never commit the real file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# --- M-Pesa Daraja (Till / Buy Goods) ---
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                  # Store / Head-Office number the passkey belongs to
MPESA_TILL_NUMBER=                # Till number customers pay (leave empty if same as shortcode)
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline   # use CustomerPayBillOnline for a Paybill
# Public https URL of THIS backend. Safaricom must be able to reach it (use ngrok while developing).
MPESA_CALLBACK_BASE_URL=https://your-domain.example
MPESA_CALLBACK_TOKEN=put-a-long-random-string-here

# --- AI Virtual Try-On ---
GEMINI_API_KEY=                   # Google AI Studio key; without it a dev-only mock preview is used
TRYON_GEMINI_MODEL=gemini-2.5-flash-image
TRYON_DAILY_LIMIT=10
TRYON_RETENTION_DAYS=30
TRYON_PILOT_PRODUCT_IDS=          # e.g. 12,15,18 (empty = all products with photos)

# --- Card payments: Stripe primary, Paystack backup ---
FRONTEND_URL=https://your-storefront.example
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=            # webhook -> <backend>/api/orders/webhooks/stripe/
PAYSTACK_SECRET_KEY=              # webhook -> <backend>/api/orders/webhooks/paystack/
CARD_PROVIDERS=stripe,paystack

# --- Social / marketing ---
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
WHATSAPP_NUMBER=254700000000
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_TIKTOK_URL=
FEED_TOKEN=                       # protects /api/integrations/feeds/meta.xml|csv
WHATSAPP_CLOUD_TOKEN=             # WhatsApp Business order updates (optional)
WHATSAPP_PHONE_NUMBER_ID=
